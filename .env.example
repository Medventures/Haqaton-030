# Copy to .env.local and fill in. Never commit real keys.

# Supabase (Project Settings → API). Public: inlined into the client bundle at build time.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only: privileged operations and the demo seed script. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
# Server-only: direct Postgres connection for applying migrations (psql).
POSTGRES_URL_NON_POOLING=postgres://...

# Public app URL (no trailing slash): server links and origin checks.
# Must match the address in the browser; prod: https://medhub-hackaton.vercel.app
APP_URL=http://localhost:3000

# OpenAI. Server-only; used by POST /api/agent/route and PMPK document recognition.
OPENAI_API_KEY=
OPENAI_MODEL=

# Not read by the code yet (getDemoConfig / getCronSecret have no callers).
DEMO_ENABLED=true
CRON_SECRET=
